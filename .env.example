# Sao chép thành .env rồi điền. Không có key thì app vẫn chạy: OCR bằng Vintern local, trích bằng bộ luật.

# LLM trích tín hiệu (OpenAI-compatible). Mặc định FPT AI Factory gpt-oss-120b như dự án AutoLead.
LLM_BASE_URL=https://mkp-api.fptcloud.com/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=

# Qwen-VL qua Hugging Face Inference Providers (router.huggingface.co).
# Token tạo ở https://huggingface.co/settings/tokens — loại "Fine-grained", tick
# "Make calls to Inference Providers". Bỏ trống thì app dùng token của `hf auth login` (nếu còn hạn).
# Lưu ý: ảnh được gửi ra ngoài — chỉ dùng với ảnh tự dựng.
HF_TOKEN=
HF_VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# llama.cpp: vulkan (GPU Intel Arc) hoặc cpu.
LLAMA_BACKEND=vulkan
LLAMA_PORT=8091

# (Tuỳ chọn) VLM qua API khác, ví dụ OpenAI gpt-4o-mini. Để trống VLM_BASE_URL = OpenAI.
VLM_BASE_URL=
VLM_MODEL=gpt-4o-mini
VLM_API_KEY=
